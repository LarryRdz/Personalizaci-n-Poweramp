<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo cristal de la isla inferior (navbar + miniplayer).
     Capa 1: relleno oscuro translucido (colorBgNavbar, modificable por la opcion de intensidad).
     Capa 2: brillo superior sutil.
     Capa 3: borde fino de alto contraste. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape>
			<corners android:radius="?com.maxmpz.audioplayer:corners_navbar"/>
			<solid android:color="?com.maxmpz.audioplayer:colorBgNavbar"/>
		</shape>
	</item>
	<item>
		<shape>
			<corners android:radius="?com.maxmpz.audioplayer:corners_navbar"/>
			<gradient
				android:angle="270"
				android:startColor="@color/glass_highlight_top"
				android:endColor="@color/glass_highlight_end"/>
		</shape>
	</item>
	<item>
		<shape>
			<corners android:radius="?com.maxmpz.audioplayer:corners_navbar"/>
			<solid android:color="#0000"/>
			<stroke android:width="1dp" android:color="@color/glass_stroke"/>
		</shape>
	</item>
</layer-list>
