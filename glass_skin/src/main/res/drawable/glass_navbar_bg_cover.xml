<?xml version="1.0" encoding="utf-8"?>
<!-- Isla "Carátula": cristal ahumado que deja ver el fondo de carátula desenfocada + grano sutil.
     La primera capa define el contorno redondeado (Poweramp recorta la navbar a ese contorno). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape>
			<corners android:radius="?com.maxmpz.audioplayer:corners_navbar"/>
			<solid android:color="?com.maxmpz.audioplayer:colorBgNavbar"/>
		</shape>
	</item>
	<item>
		<bitmap
			android:src="@drawable/glass_grain"
			android:tileMode="repeat"
			android:antialias="false"
			android:filter="false"/>
	</item>
</layer-list>
