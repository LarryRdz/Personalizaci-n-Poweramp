<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ResourceCycle, NewApi">

	<!-- Base: tema oscuro nativo de Poweramp intacto. Solo cambian:
	     colorBgNavbar  -> isla inferior (navbar + miniplayer)
	     colorBgPrimary -> menus flotantes, popups y dialogos -->
	<style name="GlassDark" parent="com.maxmpz.audioplayer:style/ActivityTheme_Black">
		<item name="com.maxmpz.audioplayer:colorBgNavbar">@color/gd_navbar</item>
		<item name="com.maxmpz.audioplayer:colorBgPrimary">@color/gd_surface</item>
		<item name="com.maxmpz.audioplayer:navbar_elevation">0dp</item>
		<item name="com.maxmpz.audioplayer:Navbar">@style/GlassNavbar</item>
		<item name="com.maxmpz.audioplayer:Navbar_scene_navbar_1line_sheet">@style/GlassNavbar_scene_navbar_1line_sheet</item>
		<item name="com.maxmpz.audioplayer:Navbar_scene_navbar_2lines">@style/GlassNavbar_scene_navbar_2lines</item>
		<item name="com.maxmpz.audioplayer:DialogForcedStyle">@style/GlassDialogForcedStyle</item>
	</style>

	<style name="GlassDark_Translucent" parent="GlassDark">
		<item name="com.maxmpz.audioplayer:colorBgNavbar">@color/gt_navbar</item>
		<item name="com.maxmpz.audioplayer:colorBgPrimary">@color/gt_surface</item>
	</style>

	<style name="GlassDark_Amoled" parent="GlassDark">
		<item name="com.maxmpz.audioplayer:colorBgNavbar">@color/ga_navbar</item>
		<item name="com.maxmpz.audioplayer:colorBgPrimary">@color/ga_surface</item>
	</style>

	<style name="GlassDark_Outline" parent="GlassDark">
		<item name="com.maxmpz.audioplayer:Navbar">@style/GlassNavbarHairline</item>
		<item name="com.maxmpz.audioplayer:Navbar_scene_navbar_1line_sheet">@style/GlassNavbarHairline_scene_navbar_1line_sheet</item>
		<item name="com.maxmpz.audioplayer:Navbar_scene_navbar_2lines">@style/GlassNavbarHairline_scene_navbar_2lines</item>
	</style>

	<!-- Navbar plano -->
	<style name="GlassNavbar" parent="com.maxmpz.audioplayer:style/Navbar">
		<item name="android:background">@drawable/glass_navbar_bg</item>
		<item name="android:elevation">0dp</item>
		<item name="com.maxmpz.audioplayer:applyViewParams">true</item>
	</style>
	<style name="GlassNavbar_scene_navbar_1line_sheet" parent="com.maxmpz.audioplayer:style/Navbar_scene_navbar_1line_sheet">
		<item name="android:background">@drawable/glass_navbar_bg</item>
		<item name="android:elevation">0dp</item>
		<item name="com.maxmpz.audioplayer:applyViewParams">true</item>
	</style>
	<style name="GlassNavbar_scene_navbar_2lines" parent="com.maxmpz.audioplayer:style/Navbar_scene_navbar_2lines">
		<item name="android:background">@drawable/glass_navbar_bg</item>
		<item name="android:elevation">0dp</item>
		<item name="com.maxmpz.audioplayer:applyViewParams">true</item>
	</style>

	<!-- Navbar con contorno fino -->
	<style name="GlassNavbarHairline" parent="GlassNavbar">
		<item name="android:background">@drawable/glass_navbar_bg_hairline</item>
	</style>
	<style name="GlassNavbarHairline_scene_navbar_1line_sheet" parent="GlassNavbar_scene_navbar_1line_sheet">
		<item name="android:background">@drawable/glass_navbar_bg_hairline</item>
	</style>
	<style name="GlassNavbarHairline_scene_navbar_2lines" parent="GlassNavbar_scene_navbar_2lines">
		<item name="android:background">@drawable/glass_navbar_bg_hairline</item>
	</style>

	<!-- Dialogos (< Android 12: sin desenfoque, no soportado por el sistema) -->
	<style name="GlassDialogForcedStyle" parent="com.maxmpz.audioplayer:style/Default_BaseDialogForcedStyle">
	</style>
</resources>
