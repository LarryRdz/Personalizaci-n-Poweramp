<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Formato #AARRGGBB. Opacidad alta: el motor de Poweramp no permite desenfocar lo que hay
	     detras de la isla, asi que con menos opacidad el texto de la lista se lee a traves (feo). -->

	<!-- Glass Dark (por defecto) -->
	<color name="gd_navbar">#EB121212</color>   <!-- 92% -->
	<color name="gd_surface">#F0161616</color>  <!-- 94%: menus, popups, dialogos -->

	<!-- Translucido -->
	<color name="gt_navbar">#D1121212</color>   <!-- 82% -->
	<color name="gt_surface">#E0161616</color>  <!-- 88% -->

	<!-- AMOLED -->
	<color name="ga_navbar">#F5000000</color>   <!-- 96% negro puro -->
	<color name="ga_surface">#F7050505</color>

	<!-- Linea fina opcional (variante "Contorno"), sin brillos ni biseles -->
	<color name="glass_hairline">#1AFFFFFF</color>
</resources>
